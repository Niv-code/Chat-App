<Window x:Class="ChatClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chat Client (MVVM)" Height="450" Width="400">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Content="Connect to Server" Height="30" Margin="0,0,0,10" 
                Background="#075E54" Foreground="White" FontWeight="Bold" 
                Command="{Binding ConnectCommand}"/>

        <ListBox Grid.Row="1" Margin="0,0,0,10" Background="#E5DDD5" FontSize="14" Padding="5"
                 ItemsSource="{Binding Messages}"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Height="40" VerticalContentAlignment="Center" Margin="0,0,10,0" Padding="5" FontSize="14"
                     Text="{Binding CurrentMessage, UpdateSourceTrigger=PropertyChanged}" />

            <Button Grid.Column="1" Content="Send" Width="80" Height="40" Background="#25D366" Foreground="White" FontWeight="Bold" 
                    Command="{Binding SendCommand}"/>
        </Grid>
    </Grid>
</Window>